<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="byedpi_cmd_settings">

    <Preference
        android:key="cmd_load_preset"
        android:title="@string/load_isp_preset_title"
        android:summary="@string/load_isp_preset_summary" />

    <Preference
        android:key="cmd_insert_flag"
        android:title="@string/cmd_insert_flag_title"
        android:summary="@string/cmd_insert_flag_summary" />

    <Preference
        android:key="cmd_history_pick"
        android:title="@string/cmd_history_title"
        android:summary="@string/cmd_history_summary" />

    <androidx.preference.PreferenceCategory
        android:title="@string/command_line_editor">

        <com.takisoft.preferencex.EditTextPreference
            android:key="byedpi_cmd_args"
            android:title="@string/command_line_arguments"
            android:dialogTitle="@string/command_line_arguments"
            android:defaultValue="-d 1 -r 1+s -M h,d -a 2"
            android:inputType="textMultiLine"
            app:useSimpleSummaryProvider="true" />

    </androidx.preference.PreferenceCategory>

    <Preference
        android:key="byedpi_readme"
        android:title="@string/byedpi_readme_link"
        android:icon="@drawable/ic_github_36">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="@string/byedpi_docs" />
    </Preference>

</PreferenceScreen>
