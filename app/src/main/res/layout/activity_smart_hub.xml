<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/smartHubRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/glass_bg_base">

    <com.sametgkte.gktedpi.ui.LiquidAmbientBackgroundView
        android:id="@+id/smartAmbientBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/smartHubContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- TOP LIQUID GLASS HEADER -->
        <LinearLayout
            android:id="@+id/smartHeaderCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_liquid_glass_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <TextView
                android:id="@+id/smartBackBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_liquid_glass_pill_active"
                android:fontFamily="@font/pjs_bold"
                android:paddingStart="13dp"
                android:paddingTop="7dp"
                android:paddingEnd="13dp"
                android:paddingBottom="7dp"
                android:text="@string/back"
                android:textColor="#FFFFFFFF"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/smartTitleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/pjs_extrabold"
                android:text="@string/smart_hub_title"
                android:textColor="@color/text_primary"
                android:textSize="17.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/smartScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="28dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- ===================================================== -->
                <!-- 1. AUTO-ISP SMART SWITCH CARD                         -->
                <!-- ===================================================== -->
                <LinearLayout
                    android:id="@+id/cardAutoIsp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_liquid_glass_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/pjs_extrabold"
                                android:text="@string/auto_isp_title"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/detectedNetworkText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:fontFamily="@font/pjs_medium"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchAutoIsp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/pjs_regular"
                        android:text="@string/auto_isp_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <!-- Slot Buttons -->
                    <TextView
                        android:id="@+id/btnSlotWifi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_liquid_glass_pill"
                        android:fontFamily="@font/pjs_bold"
                        android:padding="11dp"
                        android:textColor="@color/text_primary"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/btnSlotTtMobile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:background="@drawable/bg_liquid_glass_pill"
                        android:fontFamily="@font/pjs_bold"
                        android:padding="11dp"
                        android:textColor="@color/text_primary"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/btnSlotTurkcell"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:background="@drawable/bg_liquid_glass_pill"
                        android:fontFamily="@font/pjs_bold"
                        android:padding="11dp"
                        android:textColor="@color/text_primary"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/btnSlotVodafone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:background="@drawable/bg_liquid_glass_pill"
                        android:fontFamily="@font/pjs_bold"
                        android:padding="11dp"
                        android:textColor="@color/text_primary"
                        android:textSize="12.5sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/pjs_medium"
                            android:text="@string/auto_isp_autostart_wifi"
                            android:textColor="@color/text_primary"
                            android:textSize="12.5sp" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchAutoStartWifi"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/pjs_medium"
                            android:text="@string/auto_isp_autostart_mobile"
                            android:textColor="@color/text_primary"
                            android:textSize="12.5sp" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchAutoStartMobile"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ===================================================== -->
                <!-- 2. SHIZUKU DUAL-VPN & HOTSPOT BRIDGE CARD             -->
                <!-- ===================================================== -->
                <LinearLayout
                    android:id="@+id/cardShizukuBridge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:background="@drawable/bg_liquid_glass_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pjs_extrabold"
                        android:text="@string/shizuku_bridge_title"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/shizukuStatusText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/pjs_medium"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/pjs_regular"
                        android:text="@string/shizuku_bridge_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="11dp"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <TextView
                            android:id="@+id/btnShizukuPerm"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_liquid_glass_pill"
                            android:fontFamily="@font/pjs_bold"
                            android:gravity="center"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:text="@string/shizuku_grant_btn"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/btnShizukuResetProxy"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_liquid_glass_pill"
                            android:fontFamily="@font/pjs_bold"
                            android:gravity="center"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:text="@string/shizuku_reset_proxy_btn"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnShizukuDualVpnToggle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:background="@drawable/bg_green_cta_button"
                        android:fontFamily="@font/pjs_extrabold"
                        android:gravity="center"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:text="@string/shizuku_start_dual_vpn"
                        android:textColor="#FFFFFFFF"
                        android:textSize="13.5sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/pjs_bold"
                                android:text="@string/hotspot_share_title"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/hotspotAddressText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/modern_mono"
                                android:textColor="@color/text_secondary"
                                android:textSize="11.5sp" />
                        </LinearLayout>

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchHotspotShare"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ===================================================== -->
                <!-- 3. SMART SNI & ZERO-PING GAMING SPLIT CARD            -->
                <!-- ===================================================== -->
                <LinearLayout
                    android:id="@+id/cardSmartSni"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:background="@drawable/bg_liquid_glass_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pjs_extrabold"
                        android:text="@string/smart_sni_title"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/pjs_regular"
                        android:text="@string/smart_sni_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="11dp"
                        android:orientation="horizontal"
                        android:weightSum="3">

                        <TextView
                            android:id="@+id/btnSniOff"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_liquid_glass_pill"
                            android:fontFamily="@font/pjs_bold"
                            android:gravity="center"
                            android:paddingTop="9dp"
                            android:paddingBottom="9dp"
                            android:text="@string/sni_mode_off"
                            android:textColor="@color/text_primary"
                            android:textSize="11.5sp" />

                        <TextView
                            android:id="@+id/btnSniZeroPing"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"
                            android:layout_marginEnd="2dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_liquid_glass_pill"
                            android:fontFamily="@font/pjs_bold"
                            android:gravity="center"
                            android:paddingTop="9dp"
                            android:paddingBottom="9dp"
                            android:text="@string/sni_mode_zero_ping"
                            android:textColor="@color/text_primary"
                            android:textSize="11.5sp" />

                        <TextView
                            android:id="@+id/btnSniOnlyBlocked"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_liquid_glass_pill"
                            android:fontFamily="@font/pjs_bold"
                            android:gravity="center"
                            android:paddingTop="9dp"
                            android:paddingBottom="9dp"
                            android:text="@string/sni_mode_only_blocked"
                            android:textColor="@color/text_primary"
                            android:textSize="11.5sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/pjs_medium"
                            android:text="@string/sni_pack_gaming"
                            android:textColor="@color/text_primary"
                            android:textSize="12.5sp" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchPackGaming"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/pjs_medium"
                            android:text="@string/sni_pack_banking"
                            android:textColor="@color/text_primary"
                            android:textSize="12.5sp" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchPackBanking"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/pjs_medium"
                            android:text="@string/sni_pack_discord"
                            android:textColor="@color/text_primary"
                            android:textSize="12.5sp" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchPackDiscord"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/pjs_medium"
                            android:text="@string/sni_pack_social"
                            android:textColor="@color/text_primary"
                            android:textSize="12.5sp" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchPackSocial"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/editCustomDomains"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_code_surface"
                        android:fontFamily="@font/modern_mono"
                        android:gravity="top|start"
                        android:hint="@string/sni_custom_hint"
                        android:inputType="textMultiLine|textNoSuggestions"
                        android:minLines="2"
                        android:padding="11dp"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/btnSaveSniDomains"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_liquid_glass_pill_active"
                        android:fontFamily="@font/pjs_bold"
                        android:gravity="center"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:text="@string/sni_save_apply_btn"
                        android:textColor="#FFFFFFFF"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <!-- ===================================================== -->
                <!-- 4. APP-BASED AUTO TRIGGER (APP WATCHER) CARD          -->
                <!-- ===================================================== -->
                <LinearLayout
                    android:id="@+id/cardAppTrigger"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:background="@drawable/bg_liquid_glass_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/pjs_extrabold"
                                android:text="@string/app_trigger_title"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/appTriggerStatusText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:fontFamily="@font/pjs_medium"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchAppTrigger"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/pjs_regular"
                        android:text="@string/app_trigger_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <TextView
                            android:id="@+id/btnOpenAccessibility"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_liquid_glass_pill_active"
                            android:fontFamily="@font/pjs_bold"
                            android:gravity="center"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:text="@string/app_trigger_auth_btn"
                            android:textColor="#FFFFFFFF"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/btnSelectTriggerApps"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_liquid_glass_pill"
                            android:fontFamily="@font/pjs_bold"
                            android:gravity="center"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:text="@string/app_trigger_pick_apps_btn"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnTriggerSleepDelay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_liquid_glass_pill"
                        android:fontFamily="@font/pjs_bold"
                        android:padding="11dp"
                        android:textColor="@color/text_primary"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <!-- ===================================================== -->
                <!-- 5. GKTECONNECT MINI SDK CARD                          -->
                <!-- ===================================================== -->
                <LinearLayout
                    android:id="@+id/cardSdkBridge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:background="@drawable/bg_liquid_glass_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pjs_extrabold"
                        android:text="@string/sdk_card_title"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/sdkLiveStatusText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/modern_mono"
                        android:textColor="@color/text_secondary"
                        android:textSize="11.5sp" />

                    <TextView
                        android:id="@+id/btnCopySdkSnippet"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_liquid_glass_pill_active"
                        android:fontFamily="@font/pjs_bold"
                        android:gravity="center"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:text="@string/sdk_copy_snippet_btn"
                        android:textColor="#FFFFFFFF"
                        android:textSize="12.5sp" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
