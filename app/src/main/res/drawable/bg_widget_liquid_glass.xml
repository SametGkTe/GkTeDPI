<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="315"
                android:startColor="#D8162234"
                android:centerColor="#DE0B111B"
                android:endColor="#DF071710"
                android:type="linear" />
            <stroke
                android:width="1.4dp"
                android:color="#D9FFFFFF" />
        </shape>
    </item>
    <item
        android:left="1dp"
        android:right="1dp"
        android:top="1dp"
        android:bottom="42dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="23dp"
                android:topRightRadius="23dp" />
            <gradient
                android:angle="270"
                android:startColor="#38FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
